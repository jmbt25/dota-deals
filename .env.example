# dota-deals environment configuration.
# Copy to `.env` (which is gitignored) and edit as needed.
# All variables are optional; defaults are documented in src/dota_deals/config.py.

# --- Storage ---

# Storage is Cloudflare D1 (see the CLOUDFLARE_* section below). The
# DB_PATH below is a vestigial setting: a handful of Settings fields
# still take a Path for legacy R2-sync code paths that Phase 10 will
# retire. Setting it has no effect on production storage.
DB_PATH=./data/dota_deals.db


# --- Steam Market ---

# Currency ID and country sent with every Steam request. `1` = USD, `US` keeps
# pricing in USD regardless of the IP geolocation of the runner.
STEAM_CURRENCY_ID=1
STEAM_COUNTRY=US

# Max concurrent in-flight Steam requests. Steam's unofficial limit is roughly
# one req/sec/IP; 2 is the polite default.
STEAM_CONCURRENCY=2

# Per-request timeout, seconds.
REQUEST_TIMEOUT_S=15.0

# Global cool-down after a 429 response, seconds. Applied in addition to the
# tenacity retry backoff for the failing request.
COOLDOWN_429_S=60.0


# --- Cadence ---

# How often the ingest stage runs. Configurable so we can dial it back if Steam
# tightens rate limits. The scheduler honors this; signals are recomputed
# nightly regardless.
INGEST_CADENCE_HOURS=8


# --- Logging ---

# `console` for human-readable output; `json` for line-delimited JSON.
# Output always goes to stderr.
LOG_FORMAT=console


# --- Cloudflare R2 (S3-compatible) ---

# Used by `dota-deals db pull` and `dota-deals db push` to sync the SQLite
# database between scheduled GitHub Actions runs. All four fields below
# must be set together for the R2 client to start. The R2 bucket and
# credentials are managed in the Cloudflare dashboard.

# R2 endpoint URL (Cloudflare gives this with the bucket; e.g.
# https://<account>.r2.cloudflarestorage.com).
R2_ENDPOINT=

# Target bucket name.
R2_BUCKET=

# API token credentials scoped to the bucket. Treat as secrets.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Object key for the SQLite file. Defaults to `dota_deals.db`. Change if
# you share a bucket across environments (e.g. `prod/dota_deals.db`).
R2_DB_KEY=dota_deals.db


# --- Cloudflare D1 (HTTP REST) ---

# Storage backend. All three credential fields below must be set
# together for the D1 client to start. Database lives in the ENAM
# region; the API token needs the "D1: Edit" permission on this
# database. Treat the token as a secret (it can read and modify
# every table).

# Cloudflare account ID (visible in the dashboard URL or `Account ID` widget).
CLOUDFLARE_ACCOUNT_ID=

# The D1 database UUID, NOT the human-readable database name. Get it from
# the D1 dashboard or `wrangler d1 list`.
CLOUDFLARE_D1_DATABASE_ID=

# API token scoped to D1: Edit on this database.
CLOUDFLARE_D1_API_TOKEN=

# Per-request timeout, seconds. D1's typical p99 is well under 30s; the
# headroom covers cold starts and pathological queries.
D1_TIMEOUT_S=30.0

# Max statements per batch HTTP request. D1's practical ceiling is around
# 100; the default amortizes HTTP latency without risking the request
# size cap.
D1_MAX_BATCH_SIZE=100

# Soft warning threshold for cumulative rows-read on a single D1
# connection. The connection logs a WARNING on close if the total
# exceeds this — early signal for an accidentally-unbounded scan.
# Default 1M is generous; the v1 universe well under fits inside.
D1_DAILY_BUDGET_WARN=1000000
