{
  "name": "dota-deals-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only D1-backed API for dota-deals, deployed as Cloudflare Pages Functions.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
